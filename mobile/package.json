{
  "name": "phone-store-manager-mobile",
  "version": "1.5.8",
  "private": true,
  "description": "Android companion for Phone Store Manager",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "npm run build && cap sync android",
    "android": "npm run sync && cap open android",
    "android:dev": "cap run android --live-reload --external",
    "android:keystore": "node scripts/make-keystore.mjs",
    "android:assets": "node scripts/make-android-assets.mjs",
    "android:apk": "node scripts/android-apk.mjs",
    "android:copy": "node scripts/copy-apk.mjs",
    "android:core": "node scripts/build-android-core.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "sql.js": "^1.14.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
