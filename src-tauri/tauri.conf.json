{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phone Store Manager",
  "version": "../package.json",
  "identifier": "dz.phonestoremanager.app",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: appfile: http://appfile.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' about: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Next Level Dev Labs",
    "copyright": "Phone Store Manager",
    "category": "Business",
    "shortDescription": "Offline desktop app for mobile phone shops in Algeria",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../build/mobile/": "mobile/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Arabic",
          "French",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
