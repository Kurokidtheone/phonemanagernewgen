{
  "name": "phone-store-manager",
  "productName": "Phone Store Manager",
  "version": "1.5.8",
  "description": "Offline desktop app for mobile phone shops in Algeria",
  "author": "Next Level Dev Labs",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:rust",
    "dist:win": "tauri build --bundles nsis",
    "dist:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri": "tauri",
    "license:init": "node scripts/make-license-key.mjs",
    "new-product": "node scripts/new-product.mjs",
    "icon": "node scripts/make-branding.mjs && tauri icon build/icon.png --output src-tauri/icons && node -e \"require('fs').copyFileSync('src-tauri/icons/icon.ico','build/icon.ico')\"",
    "mobile:check": "npm --prefix mobile run typecheck && npm --prefix mobile test",
    "mobile:build": "npm --prefix mobile run build && npm --prefix mobile exec cap sync android",
    "perf": "cargo test -p psm-core --release --test perf -- --ignored --nocapture"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.52.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
